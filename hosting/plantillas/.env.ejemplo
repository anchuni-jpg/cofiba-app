# Configuración de la app Cofiba.
# En un hosting con panel, pon estas variables en el propio panel
# ("Variables de entorno"). En un VPS, copia este archivo como .env
# (en la misma carpeta) y rellénalo.

# Puerto donde escucha la app. Muchos paneles lo ponen solos: déjalo así.
PORT=4000

# Modo producción (sirve la app y la API desde el mismo sitio).
NODE_ENV=production

# OPCIONAL: carpeta donde se guardan los datos (índice del catálogo,
# histórico, sesiones guardadas). Si tu hosting borra los archivos en cada
# reinicio, apúntala a un disco persistente (p. ej. /data). Si no la pones,
# se usa server/.data dentro de la propia app.
# DATA_DIR=/data

# OPCIONAL: clave para el programa de escritorio de administración.
# Pon una clave larga e inventada. Si no lo usas, déjala comentada.
# ADMIN_TOKEN=pon-aqui-una-clave-larga-y-secreta
